{
  "manifest_version": 3,
  "name": "BBX",
  "description": "BBX is an unofficial extension for braceletbook.com",
  "version": "1.3.3",
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [ "tabs", "scripting" ],
  "host_permissions": ["https://*/*"],
  "commands": { },
  "browser_specific_settings": {
    "gecko": {
      "id": "bbx@batujk.com",
      "data_collection_permissions": {
        "required": [ "none" ]
      }
    }
  }
}
